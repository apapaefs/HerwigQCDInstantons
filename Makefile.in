# -*- Makefile -*- (for emacs)
#
# This Makefile is intended for compiling Herwig++ plugins
#
# This Makefile received very little testing, 
# any bug reports are very welcome!
#
# Location of include files
THEPEGINCLUDE  =
HERWIGINCLUDE  =
GSLINCLUDE     = 
FASTJETINCLUDE = 
BOOSTINCLUDE =
HEPMCINCLUDE =
PYTHONINCLUDE =
PYTHONPATH =
HERWIGINSTALL =
FCLIBS =
LDFLAGS =
PLUGIN_LIBS = $(shell gsl-config --libs)
SHARED_FLAG = 
INCLUDE = $(THEPEGINCLUDE) $(HERWIGINCLUDE) $(GSLINCLUDE) $(FASTJETINCLUDE) $(BOOSTINCLUDE) $(HEPMCINCLUDE) $(PYTHONINCLUDE)
# C++ flags
CXX =
CXXFLAGS =

ALLCCFILES=$(shell echo *.cc)

default : Instantons.so

%.o : %.cc %.h
	$(CXX) -fPIC $(CPPFLAGS) $(INCLUDE) $(CXXFLAGS) -c -shared $< -o $@

Instantons.so : MEInstanton.o
	$(CXX) -fPIC $(CPPFLAGS) $(INCLUDE) $(CXXFLAGS) $(SHARED_FLAG) $(LDFLAGS) \
	$^ $(FCLIBS) $(PLUGIN_LIBS) -o $@

clean:
	rm -f $(ALLCCFILES:.cc=.o) \
	Instantons.so

install:
	cp Instantons.so $(HERWIGINSTALL)/lib/Herwig
