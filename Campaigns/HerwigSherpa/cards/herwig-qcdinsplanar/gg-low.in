# -*- ThePEG-repository -*-
# Generated by run_campaign.py render; edit campaign.json or common.in.

read Campaigns/HerwigSherpa/cards/herwig/common.in

# Colour-flow systematic; all other generator settings match the baseline.
set /Herwig/MatrixElements/MEInstanton:ColourConnections QCDINSPlanar

set /Herwig/Generators/EventGenerator:NumberOfEvents 50000
set /Herwig/Generators/EventGenerator:RandomNumberGenerator:Seed 755704137
set /Herwig/MatrixElements/MEInstanton:Processes GG
set /Herwig/Cuts/InstantonCuts:MHatMin 30.0*GeV
set /Herwig/Cuts/InstantonCuts:MHatMax 2895.5*GeV
set /Herwig/Analysis/Rivet:Filename herwig-qcdinsplanar-gg-low.yoda

cd /Herwig/Generators
saverun Campaign-herwig-qcdinsplanar-gg-low EventGenerator
