# -*- ThePEG-repository -*-
# Generated by run_campaign.py render; edit campaign.json or common.in.

read Campaigns/HerwigSherpa/cards/herwig/common.in

# Full Herwig dipole-shower variation. The native tune also changes shower
# alpha_s, infrared cutoffs, constituent masses, and hadronization parameters.
set /Herwig/EventHandlers/EventHandler:CascadeHandler /Herwig/DipoleShower/DipoleShowerHandler
read snippets/Dipole_AutoTunes_gss.in

# Restore the settings held fixed in this Herwig/Sherpa comparison.
set /Herwig/DipoleShower/DipoleShowerHandler:PDFA /Herwig/Partons/InstantonPDF
set /Herwig/DipoleShower/DipoleShowerHandler:PDFB /Herwig/Partons/InstantonPDF
set /Herwig/DipoleShower/DipoleShowerHandler:MPIHandler NULL
# MPI-on alternative:
#set /Herwig/DipoleShower/DipoleShowerHandler:MPIHandler /Herwig/UnderlyingEvent/MPIHandler
set /Herwig/Particles/u:NominalMass 0*GeV
set /Herwig/Particles/ubar:NominalMass 0*GeV
set /Herwig/Particles/u:HardProcessMass 0.0023*GeV
set /Herwig/Particles/ubar:HardProcessMass 0.0023*GeV
set /Herwig/Particles/d:NominalMass 0*GeV
set /Herwig/Particles/dbar:NominalMass 0*GeV
set /Herwig/Particles/d:HardProcessMass 0.005*GeV
set /Herwig/Particles/dbar:HardProcessMass 0.005*GeV
set /Herwig/Particles/s:NominalMass 0*GeV
set /Herwig/Particles/sbar:NominalMass 0*GeV
set /Herwig/Particles/s:HardProcessMass 0.093*GeV
set /Herwig/Particles/sbar:HardProcessMass 0.093*GeV
set /Herwig/Particles/c:NominalMass 0*GeV
set /Herwig/Particles/cbar:NominalMass 0*GeV
set /Herwig/Particles/c:HardProcessMass 1.27*GeV
set /Herwig/Particles/cbar:HardProcessMass 1.27*GeV
set /Herwig/Particles/b:NominalMass 0*GeV
set /Herwig/Particles/bbar:NominalMass 0*GeV
set /Herwig/Particles/b:HardProcessMass 4.18*GeV
set /Herwig/Particles/bbar:HardProcessMass 4.18*GeV
# Five-flavour ISR uses massless canonical quark data. MEInstanton detects
# the distinct HardProcessMass values and makes private physical-mass data
# for outgoing zero modes, so their MAMBO masses remain matched to Sherpa.
# The hard outgoing zero modes use private physical-mass ParticleData.
# These two adapters preserve that emitter record after radiation;
# their splitting functions and kinematics are otherwise unchanged.
set /Herwig/DipoleShower/Kernels/FFMdx2dgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FFMux2ugxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FFMcx2cgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FFMsx2sgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FFMbx2bgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FIMdx2dgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FIMux2ugxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FIMcx2cgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FIMsx2sgxDipoleKernel:UseKernel No
set /Herwig/DipoleShower/Kernels/FIMbx2bgxDipoleKernel:UseKernel No
create Herwig::InstantonFFMqx2qgxDipoleKernel /Herwig/DipoleShower/Kernels/InstantonFFMqx2qgxDipoleKernel
set /Herwig/DipoleShower/Kernels/InstantonFFMqx2qgxDipoleKernel:PDFRatio /Herwig/DipoleShower/Kernels/PDFRatio
set /Herwig/DipoleShower/Kernels/InstantonFFMqx2qgxDipoleKernel:SplittingKinematics /Herwig/DipoleShower/Kinematics/FFMassiveKinematics
set /Herwig/DipoleShower/Kernels/InstantonFFMqx2qgxDipoleKernel:CMWScheme Factor
insert /Herwig/DipoleShower/DipoleShowerHandler:Kernels 0 /Herwig/DipoleShower/Kernels/InstantonFFMqx2qgxDipoleKernel
create Herwig::InstantonFIMqx2qgxDipoleKernel /Herwig/DipoleShower/Kernels/InstantonFIMqx2qgxDipoleKernel
set /Herwig/DipoleShower/Kernels/InstantonFIMqx2qgxDipoleKernel:PDFRatio /Herwig/DipoleShower/Kernels/PDFRatio
set /Herwig/DipoleShower/Kernels/InstantonFIMqx2qgxDipoleKernel:SplittingKinematics /Herwig/DipoleShower/Kinematics/FIMassiveKinematics
set /Herwig/DipoleShower/Kernels/InstantonFIMqx2qgxDipoleKernel:CMWScheme Factor
insert /Herwig/DipoleShower/DipoleShowerHandler:Kernels 0 /Herwig/DipoleShower/Kernels/InstantonFIMqx2qgxDipoleKernel
set /Herwig/MatrixElements/MEInstanton:ColourConnections Random3

set /Herwig/Generators/EventGenerator:NumberOfEvents 20000
set /Herwig/Generators/EventGenerator:RandomNumberGenerator:Seed 529037101
set /Herwig/MatrixElements/MEInstanton:Processes All
set /Herwig/Cuts/InstantonCuts:MHatMin 500.0*GeV
set /Herwig/Cuts/InstantonCuts:MHatMax 2895.5*GeV
set /Herwig/Analysis/Rivet:Filename herwig-random3-dipole-all-high.yoda

cd /Herwig/Generators
saverun Campaign-herwig-random3-dipole-all-high EventGenerator
