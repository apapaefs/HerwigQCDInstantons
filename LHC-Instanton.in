 # -*- ThePEG-repository -*-

##################################################
# Example generator based on LHC parameters
# usage: Herwig read LHC.in
##################################################

read snippets/PPCollider.in

##################################################
# Technical parameters for this run
##################################################

cd /Herwig/EventHandlers 
#set EventHandler:CascadeHandler        NULL
#set EventHandler:HadronizationHandler  NULL 
#set EventHandler:DecayHandler          NULL 
# The handler for multiple parton interactions 
#set /Herwig/Shower/ShowerHandler:MPIHandler       NULL
set /Herwig/Shower/ShowerHandler:MaxTry 5
# Audit finding: Herwig 7.3's default Colour3 reconstruction rejected about
# 88% of tested high-multiplicity instanton showers; General reduced this
# to about 3%, avoiding a strong survivor bias in that controlled sample.
set /Herwig/Shower/KinematicsReconstructor:ReconstructionOption General

cd /Herwig/Generators
set EventGenerator:NumberOfEvents 10000000
set EventGenerator:RandomNumberGenerator:Seed 31122001
set EventGenerator:PrintEvent 1000
set EventGenerator:DebugLevel 1
set EventGenerator:MaxErrors 100000

#############################
# the default sampler (flat)
#############################
set /Herwig/Samplers/FlatBinSampler:NIterations 2
set /Herwig/Samplers/FlatBinSampler:InitialPoints 10000
set /Herwig/Samplers/Sampler:BinSampler /Herwig/Samplers/FlatBinSampler
set /Herwig/Samplers/Sampler:Verbose Yes
set /Herwig/Samplers/Sampler:AlmostUnweighted Yes
set /Herwig/Samplers/Sampler:BinSampler:Kappa 0.01

#set /Herwig/Samplers/Sampler:BinSampler /Herwig/Samplers/MonacoSampler
#set /Herwig/Samplers/Sampler:BinSampler /Herwig/Samplers/CellGridSampler

########################
## sqrt(s) = 13000 GeV ##
########################
set /Herwig/Generators/EventGenerator:EventHandler:LuminosityFunction:Energy 13000.0
set EventGenerator:EventHandler:MaxLoop 10000000

set EventGenerator:EventHandler:Sampler /Herwig/Samplers/Sampler

cd /Herwig/Cuts
set JetKtCut:MinKT 0.0*GeV

cd /Herwig/Analysis
set Basics:CheckQuark false # removes warning that there are quarks in the final state in case hadronization is turned off


##################################################
# Matrix Elements for hadron-hadron collisions 
##################################################

# The MAMBO phase space
cd /Herwig/MatrixElements/Matchbox/Phasespace
create Herwig::MamboPhasespace MamboPS
set MamboPS:CouplingData PhasespaceCouplings

cd /Herwig/MatrixElements/
create Herwig::MEInstanton MEInstanton Instantons.so
insert SubProcess:MatrixElements[0] MEInstanton
# Repaired MAMBO is the default stochastic, non-invertible generator.
set MEInstanton:Phasespace /Herwig/MatrixElements/Matchbox/Phasespace/MamboPS
# Deterministic alternative: comment the line above and uncomment this line.
#set MEInstanton:Phasespace /Herwig/MatrixElements/Matchbox/Phasespace/InvertiblePhasespace

# You may wish to use the same PDF as the events were generated with
create ThePEG::LHAPDF /Herwig/Partons/LHAPDF ThePEGLHAPDF.so
set /Herwig/Partons/LHAPDF:PDFName NNPDF31_nnlo_as_0118
set /Herwig/Partons/LHAPDF:RangeException Freeze # Freeze the PDF outside the pre-defined ranges
set /Herwig/Partons/RemnantDecayer:AllowTop Yes
set /Herwig/Partons/LHAPDF:RemnantHandler /Herwig/Partons/HadronRemnants
set /Herwig/Particles/p+:PDF /Herwig/Partons/LHAPDF
set /Herwig/Particles/pbar-:PDF /Herwig/Partons/LHAPDF
set /Herwig/Partons/PPExtractor:FirstPDF  /Herwig/Partons/LHAPDF
set /Herwig/Partons/PPExtractor:SecondPDF /Herwig/Partons/LHAPDF

# We would recommend the shower uses the default PDFs with which it was tuned.
# However it can be argued that the same set as for the sample should be used for
# matched samples, i.e. MC@NLO (and less so POWHEG)
set /Herwig/Shower/ShowerHandler:PDFA /Herwig/Partons/LHAPDF
set /Herwig/Shower/ShowerHandler:PDFB /Herwig/Partons/LHAPDF


################
#PARAMETERS
################

# Use massless hard-process quark legs for a common MAMBO/invertible convention.
# KKSBottomMass below remains the physical mass used for flavour selection.
set /Herwig/Particles/u:HardProcessMass 0*GeV
set /Herwig/Particles/ubar:HardProcessMass 0*GeV
set /Herwig/Particles/d:HardProcessMass 0*GeV
set /Herwig/Particles/dbar:HardProcessMass 0*GeV
set /Herwig/Particles/s:HardProcessMass 0*GeV
set /Herwig/Particles/sbar:HardProcessMass 0*GeV
set /Herwig/Particles/c:HardProcessMass 0*GeV
set /Herwig/Particles/cbar:HardProcessMass 0*GeV
set /Herwig/Particles/b:HardProcessMass 0*GeV
set /Herwig/Particles/bbar:HardProcessMass 0*GeV

# the number of quark pairs to consider
set MEInstanton:NQuarkPair 4 # if "QuarkPairs" is "Fixed", then this will be the number of quark pairs
set MEInstanton:QuarkPairs VariableKKS
set MEInstanton:KKSBottomMass 4.18*GeV

# the maximum number of additional gluons on top of the quark pairs
set MEInstanton:NAdditional 10


# MEModeling = Flat (default) parameters:
# the parametrization of multiplicities:
set MEInstanton:MultiplicityParametrisation Poisson
set MEInstanton:PoissonMean 3.0
# the choice of the parameters if the MultiplicityParametrisation is "Gaussian"
set MEInstanton:GaussianParamA 5.
set MEInstanton:GaussianParamB 200.

# MEModeling = KKS (Khoze, Krauss, Schott, 1911.09726)
set MEInstanton:MEModeling KKS
set MEInstanton:FactorizationScale InvRho # InvRho or sHat
create ThePEG::Cuts /Herwig/Cuts/ResetCuts
set /Herwig/EventHandlers/EventHandler:Cuts /Herwig/Cuts/ResetCuts
set /Herwig/Cuts/ResetCuts:MHatMin 20*GeV # 10.7*GeV # 10.7*GeV
set /Herwig/Cuts/ResetCuts:MHatMax 2895.5*GeV

# Choose the colour connections
set MEInstanton:ColourConnections Random3

cd /Herwig/Generators

##################################################
# Save run for later usage with 'Herwig run'
##################################################
saverun LHC-Instanton EventGenerator
